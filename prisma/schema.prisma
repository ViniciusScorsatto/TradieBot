generator client {
  provider = "prisma-client"
  output   = "../dashboard/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                           String        @id @default(cuid())
  telegramUserId               String        @unique @map("telegram_user_id")
  telegramHandle               String?       @map("telegram_handle")
  firstName                    String?       @map("first_name")
  lastName                     String?       @map("last_name")
  planTier                     String        @default("FREE") @map("plan_tier")
  stripeCustomerId             String?       @unique @map("stripe_customer_id")
  invoiceCountThisMonth        Int           @default(0) @map("invoice_count_this_month")
  voiceSecondsThisMonth        Int           @default(0) @map("voice_seconds_this_month")
  paidInvoiceCredits           Int           @default(0) @map("paid_invoice_credits")
  paidVoiceSeconds             Int           @default(0) @map("paid_voice_seconds")
  promotionConsentAt           DateTime?     @map("promotion_consent_at")
  promotionConsentSource       String?       @map("promotion_consent_source")
  promotionOptOutAt            DateTime?     @map("promotion_opt_out_at")
  joinedAt                     DateTime      @default(now()) @map("joined_at")
  updatedAt                    DateTime      @updatedAt @map("updated_at")
  profile                      Profile?
  clients                      Client[]
  invoiceDrafts                InvoiceDraft[]
  invoices                     Invoice[]
  quotes                       Quote[]
  tickets                      Ticket[]
  payments                     Payment[]
  promotionPreferences         PromotionPreference[]
  promotionDeliveries          PromotionDelivery[]
  trackingSession              TimeTrackingSession?

  @@map("users")
}

model Profile {
  id                String   @id @default(cuid())
  userId            String   @unique @map("user_id")
  companyName       String?  @map("company_name")
  address           String?
  gstNumber         String?  @map("gst_number")
  email             String?
  phone             String?
  bankDetails       String?  @map("bank_details")
  logoUrl           String?  @map("logo_url")
  defaultTemplateId String   @default("classic-blue") @map("default_template_id")
  invoicePrefix     String   @default("INV") @map("invoice_prefix")
  nextInvoiceNumber Int      @default(1) @map("next_invoice_number")
  quotePrefix       String   @default("QUO") @map("quote_prefix")
  nextQuoteNumber   Int      @default(1) @map("next_quote_number")
  defaultHourlyRateCents Int @default(0) @map("default_hourly_rate_cents")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Client {
  id        String        @id @default(cuid())
  userId    String        @map("user_id")
  name      String
  company   String?
  email     String?
  phone     String?
  address   String?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices  Invoice[]
  drafts    InvoiceDraft[]
  quotes    Quote[]

  @@map("clients")
}

model InvoiceDraft {
  id            String            @id @default(cuid())
  userId        String            @map("user_id")
  clientId      String?           @map("client_id")
  documentType  String            @default("INVOICE") @map("document_type")
  sourceQuoteId String?           @map("source_quote_id")
  status        String            @default("ACTIVE")
  notes         String?
  subtotalCents Int               @default(0) @map("subtotal_cents")
  gstCents      Int               @default(0) @map("gst_cents")
  totalCents    Int               @default(0) @map("total_cents")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  client        Client?           @relation(fields: [clientId], references: [id])
  items         InvoiceDraftItem[]

  @@map("invoice_drafts")
}

model InvoiceDraftItem {
  id              String       @id @default(cuid())
  draftId         String       @map("draft_id")
  description     String
  quantity        Float        @default(1)
  unitPrice       Int          @map("unit_price")
  discountCents   Int          @default(0) @map("discount_cents")
  discountPercent Float?       @map("discount_percent")
  lineTotal       Int          @map("line_total")
  createdAt       DateTime     @default(now()) @map("created_at")
  draft           InvoiceDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@map("invoice_draft_items")
}

model Invoice {
  id              String      @id @default(cuid())
  userId          String      @map("user_id")
  clientId        String?     @map("client_id")
  sourceQuoteId   String?     @map("source_quote_id")
  profileSnapshot Json        @map("profile_snapshot")
  invoiceNumber   String      @map("invoice_number")
  templateId      String      @map("template_id")
  subtotalCents   Int         @map("subtotal_cents")
  gstCents        Int         @map("gst_cents")
  totalCents      Int         @map("total_cents")
  notes           String?
  pdfUrl          String?     @map("pdf_url")
  emailedTo       String?     @map("emailed_to")
  emailedAt       DateTime?   @map("emailed_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client          Client?     @relation(fields: [clientId], references: [id])
  items           InvoiceItem[]

  @@map("invoices")
}

model Quote {
  id                String      @id @default(cuid())
  userId            String      @map("user_id")
  clientId          String?     @map("client_id")
  profileSnapshot   Json        @map("profile_snapshot")
  quoteNumber       String      @map("quote_number")
  templateId        String      @map("template_id")
  subtotalCents     Int         @map("subtotal_cents")
  gstCents          Int         @map("gst_cents")
  totalCents        Int         @map("total_cents")
  notes             String?
  emailedTo         String?     @map("emailed_to")
  emailedAt         DateTime?   @map("emailed_at")
  convertedInvoiceId String?    @map("converted_invoice_id")
  convertedAt       DateTime?   @map("converted_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client            Client?     @relation(fields: [clientId], references: [id])
  items             QuoteItem[]

  @@unique([userId, quoteNumber])
  @@map("quotes")
}

model QuoteItem {
  id              String   @id @default(cuid())
  quoteId         String   @map("quote_id")
  description     String
  quantity        Float
  unitPrice       Int      @map("unit_price")
  discountCents   Int      @default(0) @map("discount_cents")
  discountPercent Float?   @map("discount_percent")
  lineTotal       Int      @map("line_total")
  quote           Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("quote_items")
}

model TimeTrackingSession {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  draftId   String   @map("draft_id")
  startedAt DateTime @map("started_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("time_tracking_sessions")
}

model InvoiceItem {
  id              String    @id @default(cuid())
  invoiceId       String    @map("invoice_id")
  description     String
  quantity        Float
  unitPrice       Int       @map("unit_price")
  discountCents   Int       @default(0) @map("discount_cents")
  discountPercent Float?    @map("discount_percent")
  lineTotal       Int       @map("line_total")
  invoice         Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Ticket {
  id        String         @id @default(cuid())
  userId    String         @map("user_id")
  type      String
  status    String         @default("OPEN")
  subject   String
  aiFirstResponseSentAt DateTime? @map("ai_first_response_sent_at")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  TicketMessage[]

  @@map("tickets")
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String   @map("ticket_id")
  sender    String
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_messages")
}

model Payment {
  id               String        @id @default(cuid())
  userId           String        @map("user_id")
  stripeSessionId  String?       @unique @map("stripe_session_id")
  stripePaymentId  String?       @unique @map("stripe_payment_id")
  purchaseType     String        @map("purchase_type")
  amountCents      Int           @map("amount_cents")
  creditsPurchased Int           @default(0) @map("credits_purchased")
  status           String        @default("PENDING")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model PromotionPreference {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  category  String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("promotion_preferences")
}

model PromotionCampaign {
  id           String              @id @default(cuid())
  category     String
  title        String
  body         String
  affiliateUrl String             @map("affiliate_url")
  status       String             @default("DRAFT")
  createdBy    String?            @map("created_by")
  createdAt    DateTime           @default(now()) @map("created_at")
  sentAt       DateTime?          @map("sent_at")
  deliveries   PromotionDelivery[]

  @@map("promotion_campaigns")
}

model PromotionDelivery {
  id             String            @id @default(cuid())
  campaignId     String            @map("campaign_id")
  userId         String            @map("user_id")
  telegramUserId String            @map("telegram_user_id")
  status         String            @default("PENDING")
  errorMessage   String?           @map("error_message")
  deliveredAt    DateTime?         @map("delivered_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  campaign       PromotionCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("promotion_deliveries")
}

model AdminUser {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String    @map("password_hash")
  totpSecret       String?   @map("totp_secret")
  recoveryCodes    Json?     @map("recovery_codes")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("admin_users")
}
